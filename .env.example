# Ledgerline — environment template
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
#
#   cp .env.example .env

# --- Daytona -----------------------------------------------------------------
# Issue at: https://app.daytona.io/dashboard/keys
# Read automatically by the SDK: `Daytona()` with no arguments picks this up.
# BACKEND ONLY. This key can create and run sandboxes — it must never reach
# frontend/client code or a browser bundle.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# --- Ledgerline app ----------------------------------------------------------
# Mock systems of record (see forge-intent.md — three lightweight services)
CRM_BASE_URL=http://localhost:8001
ERP_BASE_URL=http://localhost:8002
ACCOUNTING_BASE_URL=http://localhost:8003

# Shared secret for inbound change webhooks from the source system
WEBHOOK_SECRET=

# Append-only audit store
AUDIT_DB_URL=sqlite:///audit.db
